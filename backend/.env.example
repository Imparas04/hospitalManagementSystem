# Copy this file to ".env" and fill in the values.   (The real .env must NEVER be committed to Git.)

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=hospital_db
# DATABASE_URL=              # optional: a full connection string; if set it replaces the DB_* values above

# ---- Security ----
# Long random text. Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRES_HOURS=8
# Website address(es) allowed to call the API, comma separated. Use your real frontend URL on a server.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Wrong-password protection on login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- First admin account (used by:  flask --app run.py create-admin) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator

# ---- Server ----
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0          # 1 only on your own computer while developing

# ---- Hospital settings ----
HOSPITAL_NAME=Smart Hospital
HOSPITAL_TIMEZONE=Asia/Kolkata
DEFAULT_TAX_PERCENT=0
EXPIRY_ALERT_DAYS=30
PAYMENT_PENDING_AFTER_DAYS=0
NOTIFICATION_SCAN_INTERVAL_SECONDS=60
