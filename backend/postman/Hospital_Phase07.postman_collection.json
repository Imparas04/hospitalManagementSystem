    {
      "name": "Notifications",
      "item": [
        {
          "name": "My notifications (pharmacist)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success && j.data.items.length) { pm.collectionVariables.set('notification_id', j.data.items[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Unread count (bell badge)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/notifications/unread-count"
          }
        },
        {
          "name": "Only unread low-stock",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/notifications?unread=true&type=low_stock"
          }
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/notifications/{{notification_id}}/read"
          }
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/notifications/read-all"
          }
        },
        {
          "name": "Doctor's notifications (lab results)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_doctor}}"
              }
            ],
            "url": "{{base_url}}/notifications"
          }
        },
        {
          "name": "Billing's notifications (payments, discharges)",
