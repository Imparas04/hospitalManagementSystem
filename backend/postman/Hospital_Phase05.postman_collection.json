{
  "info": {
    "name": "Hospital Backend - Phase 5 (Lab & Pharmacy)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_doctor",
      "value": ""
    },
    {
      "key": "token_lab",
      "value": ""
    },
    {
      "key": "token_pharmacist",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "lab_test_id",
      "value": ""
    },
    {
      "key": "lab_order_id",
      "value": ""
    },
    {
      "key": "medicine_id",
      "value": ""
    },
    {
      "key": "prescription_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Logins",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('token_admin', j.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (doctor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_doctor\",\n  \"password\": \"Demo12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('token_doctor', j.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (lab technician)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_lab_technician\",\n  \"password\": \"Demo12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('token_lab', j.data.access_token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (pharmacist)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo_pharmacist\",\n  \"password\": \"Demo12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('token_pharmacist', j.data.access_token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Laboratory",
      "item": [
        {
          "name": "Create test type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lab}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/tests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Complete Blood Count\",\n  \"code\": \"CBC\",\n  \"normal_range\": \"4.5-11.0\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('lab_test_id', j.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List test types",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lab}}"
              }
            ],
            "url": "{{base_url}}/lab/tests"
          }
        },
        {
          "name": "Doctor orders test (needs patient_id variable set from Phase 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_doctor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"lab_test_id\": \"{{lab_test_id}}\",\n  \"notes\": \"Fasting\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('lab_order_id', j.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Sample collected",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lab}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/orders/{{lab_order_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"sample_collected\"\n}"
            }
          }
        },
        {
          "name": "Processing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lab}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/orders/{{lab_order_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processing\"\n}"
            }
          }
        },
        {
          "name": "Enter result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_lab}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/orders/{{lab_order_id}}/result",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"result_value\": \"WBC 12.8 - elevated\",\n  \"is_abnormal\": true\n}"
            }
          }
        },
        {
          "name": "Doctor reviews",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_doctor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/lab/orders/{{lab_order_id}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewer_notes\": \"Start antibiotics\"\n}"
            }
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_doctor}}"
              }
            ],
            "url": "{{base_url}}/lab/orders?status=reviewed"
          }
        }
      ]
    },
    {
      "name": "Pharmacy",
      "item": [
        {
          "name": "Create medicine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/pharmacy/medicines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin\",\n  \"unit\": \"tablet\",\n  \"reorder_level\": 15\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('medicine_id', j.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Add batch (late expiry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/pharmacy/medicines/{{medicine_id}}/batches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batch_number\": \"LATE\",\n  \"expiry_date\": \"2028-06-30\",\n  \"purchase_quantity\": 10\n}"
            }
          }
        },
        {
          "name": "Add batch (early expiry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/pharmacy/medicines/{{medicine_id}}/batches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batch_number\": \"EARLY\",\n  \"expiry_date\": \"2027-03-31\",\n  \"purchase_quantity\": 10\n}"
            }
          }
        },
        {
          "name": "Medicine detail with batches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/pharmacy/medicines/{{medicine_id}}"
          }
        },
        {
          "name": "Doctor prescribes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_doctor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/prescriptions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"items\": [\n    {\n      \"medicine_id\": \"{{medicine_id}}\",\n      \"dosage\": \"1 tablet 3x daily\",\n      \"quantity\": 25\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.success) { pm.collectionVariables.set('prescription_id', j.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Pharmacist issues",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/prescriptions/{{prescription_id}}/issue"
          }
        },
        {
          "name": "Low-stock alerts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_pharmacist}}"
              }
            ],
            "url": "{{base_url}}/pharmacy/medicines?low_stock=true"
          }
        }
      ]
    }
  ]
}