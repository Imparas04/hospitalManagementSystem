# Copy this file to ".env" and fill in your real values. NEVER commit ".env".

FLASK_ENV=development

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=hospital_user
DB_PASSWORD=change_me
DB_NAME=hospital_db

# --- JWT / Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_EXPIRES_HOURS=8

# --- Billing / PDF (Phase 6) ---
# Tax % applied to bills when the request does not specify one (0 = no tax).
DEFAULT_TAX_PERCENT=0
# Printed at the top of invoices, receipts and discharge summaries.
HOSPITAL_NAME=Smart Hospital

# --- Dashboard / reports / notifications (Phase 7) ---
# What "today" means for dashboards and reports (database timestamps are UTC).
HOSPITAL_TIMEZONE=Asia/Kolkata
# Warn about medicine batches expiring within this many days.
EXPIRY_ALERT_DAYS=30
# Send a "payment pending" notification for unpaid bills older than this many days (0 = all unpaid bills).
PAYMENT_PENDING_AFTER_DAYS=0
# Alerts (low stock, expiry, payment pending) are re-checked at most this often, in seconds.
NOTIFICATION_SCAN_INTERVAL_SECONDS=60

# --- CORS (frontend origin(s), comma separated) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- First admin (used by: flask create-admin) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hospital.local
ADMIN_FULL_NAME=System Administrator
ADMIN_PASSWORD=ChangeThis123
